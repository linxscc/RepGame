# 复制本文件为 .env 并按本地环境修改（.env 不会提交到 git）
# 编辑器运行时读取 Unity 项目根目录下的 .env；打包后放在可执行文件同目录

# 游戏服务器地址
SERVER_HOST=127.0.0.1
# 游戏服务器端口
SERVER_PORT=9060

# 服务器 TLS 证书的 SHA-256 指纹（证书固定，防中间人）。
# 服务器启动日志会打印：TLS certificate SHA-256 fingerprint ... : <指纹>
# 留空时只接受系统信任的 CA 证书，连接自签名证书的服务器会失败，
# 失败日志里会给出看到的指纹，确认无误后填到这里。
SERVER_CERT_SHA256=

# 仅本地调试且服务器设置了 TLS_DISABLED=true 时才改为 false（不加密）
SERVER_TLS=true
